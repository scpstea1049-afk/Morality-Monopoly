        /* ============================================================
           遊戲畫面版面調整：標題移入棋盤中央、棋盤最大化、
           玩家欄固定高度捲動、收合式功能按鈕、玩家歷程圖層
           ============================================================ */

        /* 棋盤中央的標題與計時器 */
        #game-title {
            background: linear-gradient(90deg, var(--macaron-pink-deep), var(--macaron-lavender-deep));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            line-height: 1.3;
        }

        #timer-display {
            display: inline-block;
            background: linear-gradient(135deg, #ffffff, var(--macaron-yellow));
            border: 2px solid var(--macaron-yellow-deep);
            border-radius: 999px;
            padding: 2px 16px !important;
            box-shadow: 0 4px 10px -3px rgba(180, 140, 100, 0.35);
        }

        /* 地圖區／玩家資訊區採可拖曳調整的左右分割版面：
           預設地圖區佔 75% 寬、玩家資訊區佔 25% 寬（由 #board-pane / #sidebar-pane 的 inline flex-basis 控制，
           可透過 .pane-resizer 拖曳把手即時調整比例，JS 見 initPaneResizer()）。
           棋盤高度以「目前螢幕可用高度」為優先上限（maximize 但絕不超出），寬度則是所在窗格的 100% 與該高度兩者取最小值，
           維持正方形；--board-cap 僅作為極寬螢幕下的合理上限。
           可用高度算法：100vh 扣掉 body 的上下 padding (p-2 = 16px)。
           右側玩家欄高度改由 JS（ResizeObserver）即時同步為棋盤實際渲染高度，見 syncSidebarHeightToBoard()。 */
        :root {
            --board-cap: 1400px;
            --board-max-height: calc(100vh - 16px);
        }

        .game-main-row {
            width: 100%;
            max-width: none;
            align-items: stretch;
        }

        #board-pane {
            min-width: 280px;
            height: min(var(--board-max-height), var(--board-cap));
        }

        #sidebar-pane {
            min-width: 220px;
        }

        .pane-resizer {
            display: none;
            flex: 0 0 10px;
            margin: 0 2px;
            cursor: col-resize;
            position: relative;
        }

        .pane-resizer::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 5px;
            height: 56px;
            border-radius: 6px;
            background: linear-gradient(180deg, var(--macaron-lavender-deep), var(--macaron-pink-deep));
            box-shadow: 0 0 8px rgba(150, 110, 180, 0.45);
            transition: height 0.15s ease, width 0.15s ease;
        }

        .pane-resizer:hover::after,
        .pane-resizer.dragging::after {
            width: 7px;
            height: 72px;
        }

        @media (min-width: 768px) {
            .pane-resizer {
                display: block;
            }
        }

        /* 手機版改為上下堆疊，地圖／玩家欄的拖曳寬度比例（inline flex-basis）不應套用，改回自然高度 */
        @media (max-width: 767px) {

            #board-pane,
            #sidebar-pane {
                flex: 0 0 auto !important;
            }
        }

        /* 地圖不再強制正方形，改為同時吃滿左方窗格的寬與高（各自獨立最大化） */
        .board {
            width: 100%;
            height: 100%;
            max-width: none;
        }

        /* 玩家資訊欄：預設高度公式僅為初始佔位，實際高度會立即由 JS 同步為棋盤的實際渲染高度 */
        #player-info-container {
            height: min(100%, var(--board-max-height), var(--board-cap));
            max-height: none;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .player-info {
            cursor: pointer;
            flex: 1 1 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        /* 手機版棋盤與玩家欄改為上下堆疊 (md 以下)，玩家欄不應再套用「與棋盤等高」的公式，
           否則會造成兩者高度相加超出螢幕，改回自然高度 + 捲動的形式。
           棋盤本身在手機版也改回正方形（寬度決定高度），避免無限制吃滿螢幕高度、把玩家欄擠出畫面。 */
        @media (max-width: 767px) {
            #board-pane {
                height: auto;
            }

            .board {
                height: auto;
                aspect-ratio: 1 / 1;
            }

            #player-info-container {
                height: auto;
                max-height: 45vh;
                overflow-y: auto;
            }

            .player-info {
                flex: 0 0 auto;
                min-height: 130px;
            }

            .property-list {
                max-height: 90px;
            }
        }

