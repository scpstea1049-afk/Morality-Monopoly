    <!-- AI 生成提示：右下角浮動文字提示 (取代原本的彈出視窗) -->
    <div id="ai-toast-container" aria-live="polite"></div>

    <script>
        // ==========================================
        // 遊戲音效與背景音樂管理器 (Web Audio API 合成)
        // 零外部依賴、純原生合成、支援背景音樂與豐富趣味音效
        // ==========================================
        const soundManager = {
            audioCtx: null,
            soundEnabled: true, // 音效預設開啟
            bgmEnabled: true,   // 背景音樂預設開啟
            isBgmPlaying: false,
            bgmTimer: null,
            bgmStep: 0,
            masterGain: null,
            sfxGain: null,
            bgmGain: null,

            // 初始化 AudioContext（使用者互動後啟動）
            init() {
                if (this.audioCtx) return;
                try {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    if (!AudioContextClass) return;
                    this.audioCtx = new AudioContextClass();

                    this.masterGain = this.audioCtx.createGain();
                    this.masterGain.gain.setValueAtTime(1.0, this.audioCtx.currentTime);
                    this.masterGain.connect(this.audioCtx.destination);

                    this.sfxGain = this.audioCtx.createGain();
                    this.sfxGain.gain.setValueAtTime(0.32, this.audioCtx.currentTime);
                    this.sfxGain.connect(this.masterGain);

                    this.bgmGain = this.audioCtx.createGain();
                    this.bgmGain.gain.setValueAtTime(0.13, this.audioCtx.currentTime);
                    this.bgmGain.connect(this.masterGain);
                } catch (e) {
                    console.warn("無法初始化 Web Audio API:", e);
                }
            },

            ensureContext() {
                this.init();
                if (this.audioCtx && this.audioCtx.state === 'suspended') {
                    this.audioCtx.resume();
                }
            },

            // 開關切換
            toggleSound() {
                this.soundEnabled = !this.soundEnabled;
                this.ensureContext();
                if (this.soundEnabled) this.playClick();
                this.updateUI();
            },

            toggleBGM() {
                this.bgmEnabled = !this.bgmEnabled;
                this.ensureContext();
                if (this.bgmEnabled) {
                    this.startBGM();
                } else {
                    this.stopBGM();
                }
                this.updateUI();
            },

            updateUI() {
                const soundBtn = document.getElementById('sound-toggle-btn');
                const soundIcon = document.getElementById('sound-toggle-icon');
                const soundLabel = document.getElementById('sound-toggle-label');

                const bgmBtn = document.getElementById('bgm-toggle-btn');
                const bgmIcon = document.getElementById('bgm-toggle-icon');
                const bgmLabel = document.getElementById('bgm-toggle-label');

                if (soundBtn && soundIcon && soundLabel) {
                    if (this.soundEnabled) {
                        soundIcon.textContent = '🔊';
                        soundLabel.textContent = '音效: 開';
                        soundBtn.className = 'sound-toggle-btn px-2 py-0.5 sm:px-2.5 sm:py-1 bg-white hover:bg-emerald-50 text-emerald-800 text-[11px] sm:text-xs font-bold rounded-full shadow-sm border border-emerald-300 transition duration-200 cursor-pointer flex items-center gap-1 select-none whitespace-nowrap';
                    } else {
                        soundIcon.textContent = '🔇';
                        soundLabel.textContent = '音效: 關';
                        soundBtn.className = 'sound-toggle-btn px-2 py-0.5 sm:px-2.5 sm:py-1 bg-gray-100 hover:bg-gray-200 text-gray-500 text-[11px] sm:text-xs font-medium rounded-full shadow-sm border border-gray-300 transition duration-200 cursor-pointer flex items-center gap-1 select-none whitespace-nowrap line-through';
                    }
                }

                if (bgmBtn && bgmIcon && bgmLabel) {
                    if (this.bgmEnabled) {
                        bgmIcon.textContent = '🎵';
                        bgmLabel.textContent = 'BGM: 開';
                        bgmBtn.className = 'bgm-toggle-btn px-2 py-0.5 sm:px-2.5 sm:py-1 bg-white hover:bg-emerald-50 text-emerald-800 text-[11px] sm:text-xs font-bold rounded-full shadow-sm border border-emerald-300 transition duration-200 cursor-pointer flex items-center gap-1 select-none whitespace-nowrap';
                    } else {
                        bgmIcon.textContent = '🔇';
                        bgmLabel.textContent = 'BGM: 關';
                        bgmBtn.className = 'bgm-toggle-btn px-2 py-0.5 sm:px-2.5 sm:py-1 bg-gray-100 hover:bg-gray-200 text-gray-500 text-[11px] sm:text-xs font-medium rounded-full shadow-sm border border-gray-300 transition duration-200 cursor-pointer flex items-center gap-1 select-none whitespace-nowrap line-through';
                    }
                }
            },

            // 輔助函式：建立合成音調
            playTone(freq, type, duration, startTimeOffset = 0, targetGain = 1.0, isBGM = false) {
                if (!this.audioCtx) return;
                const now = this.audioCtx.currentTime + startTimeOffset;
                const osc = this.audioCtx.createOscillator();
                const gain = this.audioCtx.createGain();

                osc.type = type;
                osc.frequency.setValueAtTime(freq, now);

                gain.gain.setValueAtTime(0.0001, now);
                gain.gain.linearRampToValueAtTime(targetGain, now + 0.015);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

                osc.connect(gain);
                gain.connect(isBGM ? this.bgmGain : this.sfxGain);

                osc.start(now);
                osc.stop(now + duration + 0.05);
            },

            // BGM 旋律與節奏排程 (輕快歡樂的經典大富翁曲調)
            startBGM() {
                if (!this.bgmEnabled) return;
                this.ensureContext();
                if (this.isBgmPlaying) return;
                this.isBgmPlaying = true;
                this.bgmStep = 0;

                const melody = [
                    523.25, 0, 659.25, 783.99,  659.25, 523.25, 587.33, 0,      // C5 - E5 G5 | E5 C5 D5 -
                    587.33, 659.25, 587.33, 523.25, 440.00, 0, 392.00, 0,      // D5 E5 D5 C5 | A4 - G4 -
                    523.25, 0, 659.25, 783.99,  880.00, 783.99, 659.25, 0,      // C5 - E5 G5 | A5 G5 E5 -
                    659.25, 783.99, 880.00, 987.77, 1046.50, 0, 0, 0,          // E5 G5 A5 B5 | C6 - - -
                    880.00, 0, 880.00, 1046.50, 783.99, 659.25, 523.25, 0,      // A5 - A5 C6 | G5 E5 C5 -
                    587.33, 0, 659.25, 587.33,  523.25, 440.00, 392.00, 0,      // D5 - E5 D5 | C5 A4 G4 -
                    440.00, 523.25, 587.33, 659.25, 783.99, 659.25, 587.33, 0,  // A4 C5 D5 E5 | G5 E5 D5 -
                    523.25, 0, 659.25, 783.99,  523.25, 0, 0, 0                 // C5 - E5 G5 | C5 - - -
                ];

                const bassNotes = [
                    130.81, 0, 196.00, 0, 110.00, 0, 164.81, 0, // C3 G3 A2 E3
                    87.31, 0, 130.81, 0, 98.00, 0, 196.00, 0,   // F2 C3 G2 G3
                    130.81, 0, 196.00, 0, 110.00, 0, 164.81, 0, // C3 G3 A2 E3
                    87.31, 0, 98.00, 0, 130.81, 196.00, 261.63, 0,
                    110.00, 0, 164.81, 0, 130.81, 0, 196.00, 0,
                    146.83, 0, 196.00, 0, 98.00, 0, 146.83, 0,
                    110.00, 0, 146.83, 0, 98.00, 0, 196.00, 0,
                    130.81, 0, 196.00, 0, 130.81, 0, 0, 0
                ];

                const stepIntervalMs = 210;

                const playNextBgmStep = () => {
                    if (!this.isBgmPlaying || !this.bgmEnabled) return;
                    const idx = this.bgmStep % melody.length;

                    const mFreq = melody[idx];
                    if (mFreq > 0) {
                        this.playTone(mFreq, 'triangle', 0.18, 0, 0.45, true);
                    }

                    const bFreq = bassNotes[idx];
                    if (bFreq > 0) {
                        this.playTone(bFreq, 'sine', 0.19, 0, 0.55, true);
                    }

                    if (idx % 2 === 0) {
                        this.playHiHat(idx % 4 === 2 ? 0.08 : 0.04);
                    }

                    this.bgmStep++;
                    this.bgmTimer = setTimeout(playNextBgmStep, stepIntervalMs);
                };

                playNextBgmStep();
            },

            // 輕量 HiHat 節奏點綴 (白雜訊極短脈衝)
            playHiHat(vol = 0.05) {
                if (!this.audioCtx || !this.bgmGain) return;
                try {
                    const bufferSize = Math.floor(this.audioCtx.sampleRate * 0.025);
                    const buffer = this.audioCtx.createBuffer(1, bufferSize, this.audioCtx.sampleRate);
                    const data = buffer.getChannelData(0);
                    for (let i = 0; i < bufferSize; i++) {
                        data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.25));
                    }
                    const noise = this.audioCtx.createBufferSource();
                    noise.buffer = buffer;
                    const filter = this.audioCtx.createBiquadFilter();
                    filter.type = 'highpass';
                    filter.frequency.value = 7000;
                    const gain = this.audioCtx.createGain();
                    gain.gain.setValueAtTime(vol, this.audioCtx.currentTime);
                    noise.connect(filter);
                    filter.connect(gain);
                    gain.connect(this.bgmGain);
                    noise.start();
                } catch (e) {}
            },

            stopBGM() {
                this.isBgmPlaying = false;
                if (this.bgmTimer) {
                    clearTimeout(this.bgmTimer);
                    this.bgmTimer = null;
                }
            },

            // --- 各種生動有趣的遊戲音效 ---

            // 1. 擲骰子聲 (搖骰子劈啪木質撞擊)
            playDiceRoll() {
                if (!this.soundEnabled) return;
                this.ensureContext();
                if (!this.audioCtx) return;
                for (let i = 0; i < 7; i++) {
                    const delay = i * 0.08 + Math.random() * 0.03;
                    const freq = 220 + Math.random() * 200;
                    this.playTone(freq, 'triangle', 0.035, delay, 0.45);
                }
            },

            // 2. 定骰聲 (清脆落定敲擊「叩-咚」)
            playDiceLand() {
                if (!this.soundEnabled) return;
                this.ensureContext();
                if (!this.audioCtx) return;
                this.playTone(420, 'triangle', 0.05, 0, 0.6);
                this.playTone(280, 'sine', 0.08, 0.04, 0.7);
            },

            // 3. 走步聲 (彈跳水滴啵啵聲，頻率隨步伐活潑跳躍)
            playStep(stepIndex = 1) {
                if (!this.soundEnabled) return;
                this.ensureContext();
                if (!this.audioCtx) return;
                const now = this.audioCtx.currentTime;
                const osc = this.audioCtx.createOscillator();
                const gain = this.audioCtx.createGain();

                const baseFreq = 360 + (stepIndex % 8) * 35;
                osc.type = 'sine';
                osc.frequency.setValueAtTime(baseFreq, now);
                osc.frequency.exponentialRampToValueAtTime(baseFreq * 1.6, now + 0.06);

                gain.gain.setValueAtTime(0.0001, now);
                gain.gain.linearRampToValueAtTime(0.45, now + 0.01);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.08);

                osc.connect(gain);
                gain.connect(this.sfxGain);
                osc.start(now);
                osc.stop(now + 0.09);
            },

            // 4. 經過起點領取薪水 (歡樂大三和弦豐收鈴聲)
            playPassGo() {
                if (!this.soundEnabled) return;
                this.ensureContext();
                if (!this.audioCtx) return;
                const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
                notes.forEach((freq, idx) => {
                    this.playTone(freq, 'triangle', 0.22, idx * 0.08, 0.6);
                    this.playTone(freq * 2, 'sine', 0.25, idx * 0.08 + 0.01, 0.25);
                });
            },

            // 5. 購買地產 (收銀機叮噹金幣雙音 Cha-ching!)
            playBuyProperty() {
                if (!this.soundEnabled) return;
                this.ensureContext();
                if (!this.audioCtx) return;
                this.playTone(987.77, 'sine', 0.12, 0, 0.6);      // B5
                this.playTone(1318.51, 'sine', 0.35, 0.09, 0.8);   // E6
                this.playTone(2637.02, 'triangle', 0.4, 0.09, 0.3); // E7 晶亮金屬泛音
            },

            // 6. 繳交租金 / 繳納稅款 (失落滑稽的下行滑音「噢唔～」)
            playPayRent() {
                if (!this.soundEnabled) return;
                this.ensureContext();
                if (!this.audioCtx) return;
                const now = this.audioCtx.currentTime;
                const osc = this.audioCtx.createOscillator();
                const gain = this.audioCtx.createGain();

                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(460, now);
                osc.frequency.exponentialRampToValueAtTime(170, now + 0.3);

                gain.gain.setValueAtTime(0.0001, now);
                gain.gain.linearRampToValueAtTime(0.4, now + 0.02);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.32);

                osc.connect(gain);
                gain.connect(this.sfxGain);
                osc.start(now);
                osc.stop(now + 0.35);
            },

            // 7. 抽取機會 / 命運卡 (神秘奇幻魔法風鈴琶音)
            playCardDraw() {
                if (!this.soundEnabled) return;
                this.ensureContext();
                if (!this.audioCtx) return;
                const arpeggio = [587.33, 739.99, 880.00, 1174.66, 1479.98]; // D5, F#5, A5, D6, F#6
                arpeggio.forEach((freq, i) => {
                    this.playTone(freq, 'sine', 0.28, i * 0.06, 0.5);
                });
            },

            // 8. 問答答對 (清澈明亮的「叮咚！叮咚！」雙正解音)
            playQuizCorrect() {
                if (!this.soundEnabled) return;
                this.ensureContext();
                if (!this.audioCtx) return;
                // 叮
                this.playTone(659.25, 'sine', 0.18, 0, 0.6); // E5
                this.playTone(1318.51, 'triangle', 0.22, 0, 0.4);
                // 咚！(高八度更清脆)
                this.playTone(1046.50, 'sine', 0.38, 0.14, 0.7); // C6
                this.playTone(2093.00, 'triangle', 0.42, 0.14, 0.35);
            },

            // 9. 問答答錯 (低頻雙聲「逼！逼！」)
            playQuizWrong() {
                if (!this.soundEnabled) return;
                this.ensureContext();
                if (!this.audioCtx) return;
                this.playTone(160, 'sawtooth', 0.12, 0, 0.45);
                this.playTone(140, 'sawtooth', 0.16, 0.15, 0.5);
            },

            // 10. 送進監獄 (下行警報 + 鐵門關閉匡啷聲)
            playGoToJail() {
                if (!this.soundEnabled) return;
                this.ensureContext();
                if (!this.audioCtx) return;
                const now = this.audioCtx.currentTime;
                const osc = this.audioCtx.createOscillator();
                const gain = this.audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(750, now);
                osc.frequency.linearRampToValueAtTime(300, now + 0.28);
                gain.gain.setValueAtTime(0.4, now);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.3);
                osc.connect(gain);
                gain.connect(this.sfxGain);
                osc.start(now);
                osc.stop(now + 0.32);

