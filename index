            line-height: 50px;
            /* Doubled from 25px */
            text-shadow: 0 0 3px white, 0 0 5px white;
        }

        /* Removed .jail-overlay styles as it's no longer on the pawn */

        /* CSS for the shaking effect */
        @keyframes jiggle {
            0% {
                transform: translate(0px, 0px) rotate(0deg);
            }

            20% {
                transform: translate(2px, 2px) rotate(1deg);
            }

            40% {
                transform: translate(-2px, -2px) rotate(-1deg);
            }

            60% {
                transform: translate(2px, -2px) rotate(1deg);
            }

            80% {
                transform: translate(-2px, 2px) rotate(-1deg);
            }

            100% {
                transform: translate(0px, 0px) rotate(0deg);
            }
        }

        .jiggle-animation {
            animation: jiggle 0.4s infinite alternate;
        }

        .owner-indicator {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 5px;
        }

        /* 已購買土地：左下角超小型購買玩家 emoji 圖示 */
        .owner-emoji-badge {
            position: absolute;
            bottom: 6px;
            left: 1px;
            font-size: 8px;
            line-height: 1;
            z-index: 3;
            pointer-events: none;
            text-shadow: 0 0 1px #fff, 0 0 2px #fff;
        }

        @media (max-width: 768px) {
            .owner-emoji-badge {
                font-size: 6px;
                bottom: 4px;
            }
        }

        /* 玩家目前所在格子：發光外框效果 */
        .space.player-here {
            z-index: 4;
            outline: 2px solid rgba(255, 214, 100, 0.95);
            outline-offset: -2px;
            animation: space-glow-pulse 1.4s ease-in-out infinite;
