        // 用 ResizeObserver 監看棋盤本身，任何尺寸變化都即時反映到玩家欄高度上。
        function syncSidebarHeightToBoard() {
            const sidebarEl = document.getElementById('player-info-container');
            if (!sidebarEl) return;
            if (window.innerWidth < 768) { sidebarEl.style.height = ''; return; } // 手機版改用 CSS 的 max-height 規則
