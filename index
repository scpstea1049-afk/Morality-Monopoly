            const content = document.getElementById('player-history-content');
            content.innerHTML = `
                <div class="ph-header" style="border-color:${playerColors[player.id]}">
                    <h3 class="ph-title" style="color:${playerColors[player.id]}">${farmPlayerImage(player, "farm-avatar")} ${player.name} 的資產歷程</h3>
                    <div class="ph-summary">
                        <div class="ph-summary-item"><span>現金</span><strong>$${player.money.toLocaleString()}</strong></div>
                        <div class="ph-summary-item"><span>土地價值</span><strong>$${propertyValue.toLocaleString()}</strong></div>
                        <div class="ph-summary-item"><span>總資產</span><strong>$${totalAssets.toLocaleString()}</strong></div>
                    </div>
                </div>
                <div class="ph-section">
                    <h4>🏠 持有土地（${ownedProperties.length}）</h4>
                    <div class="ph-property-grid">${propertiesHTML}</div>
                </div>
                <div class="ph-section">
                    <h4>💰 租金收入來源</h4>
                    ${rentSourceHTML}
                </div>
                <div class="ph-section">
                    <h4>📜 完整收支歷程</h4>
                    <div class="ph-history-list">${historyHTML}</div>
                </div>`;

            modalContainer.classList.remove('hidden');
            modals.playerHistory.classList.remove('hidden');
        }

        // --- 玩家收支歷程記錄 ---
        // 記錄一筆收支紀錄，供「查看玩家歷程」圖層與租金來源統計使用
        function recordTransaction(player, amount, reason, type = 'other', counterpartyId = null) {
            if (!Array.isArray(player.transactions)) player.transactions = [];
            player.transactions.push({
                amount,
                reason,
                type, // 'salary' | 'tax' | 'purchase' | 'rent_income' | 'rent_expense' | 'jail' | 'card' | 'initial' | 'other'
                counterpartyId, // 對象玩家 id（例如租金的付款方/收款方）
                balanceAfter: player.money,
                time: Date.now()
            });
            if (player.transactions.length > 300) player.transactions.shift(); // 避免無限成長
        }

        // 變更玩家金錢並同步記錄歷程
        function applyMoneyChange(player, amount, reason, type = 'other', counterpartyId = null) {
            player.money += amount;
            recordTransaction(player, amount, reason, type, counterpartyId);
        }

        // Helper function to determine if a color is dark for text contrast
        function isDark(color) {
            const hex = color.replace('#', '');
            const r = parseInt(hex.substr(0, 2), 16), g = parseInt(hex.substr(2, 2), 16), b = parseInt(hex.substr(4, 2), 16);
            return ((r * 299) + (g * 587) + (b * 114)) / 1000 < 155;
        }

        // Update player pawn positions on the board and apply jiggle animation
        function updatePlayerPawns() {
            // Define relative offsets for pawns within a space, considering their doubled size
            const pawnRelativeOffsets = [
                { top: 10, left: 10 },    // Player 0: top-left corner
                { top: 10, right: 10 },   // Player 1: top-right corner
                { bottom: 10, left: 10 }, // Player 2: bottom-left corner
                { bottom: 10, right: 10 } // Player 3: bottom-right corner
            ];

            // 先清除所有格子的發光外框，再依目前玩家位置重新加上
            boardElement.querySelectorAll('.space.player-here').forEach(el => el.classList.remove('player-here'));

            gameState.players.forEach((player) => {
                const pawn = document.getElementById(`pawn-${player.id}`);
                const spaceEl = document.getElementById(`space-${player.position}`);

                if (spaceEl) spaceEl.classList.add('player-here');

                if (spaceEl && pawn) {
                    // Get the bounding rectangles of the space and the board for precise positioning
                    const spaceRect = spaceEl.getBoundingClientRect();
                    const boardRect = boardElement.getBoundingClientRect();

                    // Calculate the space's position relative to the board's top-left corner
                    const spaceLeftOnBoard = spaceRect.left - boardRect.left;
                    const spaceTopOnBoard = spaceRect.top - boardRect.top;

                    // Get the actual rendered size of the pawn (which might change with responsive CSS)
                    const pawnRect = pawn.getBoundingClientRect();
                    const pawnWidth = pawnRect.width;
                    const pawnHeight = pawnRect.height;

                    const offset = pawnRelativeOffsets[player.id % pawnRelativeOffsets.length];

                    let finalLeft, finalTop;

                    // Calculate final 'left' position based on relative offset
                    if (offset.left !== undefined) {
                        finalLeft = spaceLeftOnBoard + offset.left;
                    } else if (offset.right !== undefined) {
                        finalLeft = spaceLeftOnBoard + spaceRect.width - pawnWidth - offset.right;
                    }

                    // Calculate final 'top' position based on relative offset
                    if (offset.top !== undefined) {
                        finalTop = spaceTopOnBoard + offset.top;
                    } else if (offset.bottom !== undefined) {
                        finalTop = spaceTopOnBoard + spaceRect.height - pawnHeight - offset.bottom;
                    }

                    // Apply calculated absolute positioning
                    pawn.style.position = 'absolute';
                    pawn.style.left = `${finalLeft}px`;
                    pawn.style.top = `${finalTop}px`;
                    // Clear other positioning properties to avoid conflicts
                    pawn.style.right = 'auto';
                    pawn.style.bottom = 'auto';
                }
            });
            updateCurrentPlayerPawnJiggle(); // Update jiggle after all pawns are positioned
        }

        // New: Function to update jail status in player info
        function updateJailStatusDisplay() {
            gameState.players.forEach(player => {
                const playerJailStatusEl = document.getElementById(`player-jail-status-${player.id}`);
                if (playerJailStatusEl) {
                    if (player.inJail) {
                        const turnsLeft = 4 - player.jailTurns;
                        playerJailStatusEl.textContent = `監獄中: 剩 ${turnsLeft} 回合`;
                        playerJailStatusEl.classList.remove('hidden');
                    } else {
                        playerJailStatusEl.classList.add('hidden');
                    }
                }
            });
        }


        // Applies/removes jiggle animation to the current player's pawn
        function updateCurrentPlayerPawnJiggle() {
            // Remove jiggle from all pawns first
            gameState.players.forEach(player => {
                const pawn = document.getElementById(`pawn-${player.id}`);
                if (pawn) {
                    pawn.classList.remove('jiggle-animation');
                }
            });

            // Add jiggle to the current player's pawn
            const currentPlayerPawn = document.getElementById(`pawn-${gameState.currentPlayerIndex}`);
            if (currentPlayerPawn) {
                currentPlayerPawn.classList.add('jiggle-animation');
            }
        }

        // Update the main game message
        function updateGameMessage(message) {
            const msgEl = document.getElementById('game-message');
            refreshFarmCompanion();
            if (msgEl) msgEl.textContent = message || `輪到 ${gameState.players[gameState.currentPlayerIndex].name} ${gameState.players[gameState.currentPlayerIndex].emoji}`;
        }

        // This function determines if the current player gets another turn (doubles) or if it switches.
        // `validActionTaken` is true if the player answered a quiz correctly AND performed the space action,
        // or if no quiz was required/relevant for that space.
        function endTurn(validActionTaken = true) {
            // If doubles, and the action was valid (or no quiz was involved), allow another roll.
            if (gameState.dice[0] === gameState.dice[1] && validActionTaken) {
                showMessage('你擲出了雙倍點數，可以再擲一次！', () => {
                    document.getElementById('roll-dice-btn').disabled = false;
                    updateGameMessage(`輪到 ${gameState.players[gameState.currentPlayerIndex].name} ${gameState.players[gameState.currentPlayerIndex].emoji}`);
                    updateCurrentPlayerPawnJiggle(); // Ensure jiggle is on current player if they roll again
                });
            } else {
                // Otherwise, switch to the next player.
                switchPlayer();
            }
            saveGameState();
        }

        // Switch to the next player's turn
        function switchPlayer() {
            gameState.currentPlayerIndex = (gameState.currentPlayerIndex + 1) % gameState.players.length;
            // Skip bankrupt players only if there are still active players left
            const activePlayers = gameState.players.filter(p => p.money >= 0);
            if (activePlayers.length > 0) {
                while (gameState.players[gameState.currentPlayerIndex].money < 0 && activePlayers.length > 0) {
                    gameState.currentPlayerIndex = (gameState.currentPlayerIndex + 1) % gameState.players.length;
                    // Re-filter active players in case the loop runs multiple times and players go bankrupt
                    const currentActivePlayers = gameState.players.filter(p => p.money >= 0);
                    if (currentActivePlayers.length === 0) {
                        endGame(); // All players bankrupt
                        return;
                    }
                }
                // If the loop finished and the current player is still bankrupt (meaning all remaining are bankrupt)
                if (gameState.players[gameState.currentPlayerIndex].money < 0) {
                    endGame();
                    return;
                }
            } else {
                // If all players are bankrupt, game ends.
                endGame();
                return;
            }

            updateGameMessage();
            drawPlayerInfo();
            updateCurrentPlayerPawnJiggle(); // Update jiggle after switching player
            document.getElementById('roll-dice-btn').disabled = false;

            if (gameState.players[gameState.currentPlayerIndex].inJail) handleJailTurn();
            saveGameState();
        }
        // ============================================================
        // 3D 骰子 (three.js)：翻滾動畫會在棋盤中央區塊內隨機呈現，最後停在正確點數
        // ============================================================
        let diceScene, diceCamera, diceRenderer, diceMeshes = [];
        let diceRollBtn = null, diceRaycaster = null, diceHover = false, dicePressUntil = 0, diceAnimating = false, diceBtnSkin = null;
        let diceInitFailed = false; // WebGL/three.js 不可用時設為 true，避免重複嘗試初始化
        // 骰子本地座標軸對應點數（相對面點數和為 7，符合標準骰子規則）
        const DICE_VALUE_BY_AXIS = { posY: 1, negY: 6, posX: 3, negX: 4, posZ: 2, negZ: 5 };

        // 繪製單一骰子面貼圖（白底圓角 + 黑點），回傳 CanvasTexture
        function createDiceFaceTexture(pipCount) {
            const size = 128;
            const canvas = document.createElement('canvas');
            canvas.width = size; canvas.height = size;
            const ctx = canvas.getContext('2d');

            const drawRoundedRect = (x, y, w, h, r) => {
                ctx.beginPath();
                ctx.moveTo(x + r, y);
                ctx.arcTo(x + w, y, x + w, y + h, r);
                ctx.arcTo(x + w, y + h, x, y + h, r);
                ctx.arcTo(x, y + h, x, y, r);
                ctx.arcTo(x, y, x + w, y, r);
                ctx.closePath();
            };

            const gradient = ctx.createLinearGradient(0, 0, size, size);
            gradient.addColorStop(0, '#ffffff');
            gradient.addColorStop(1, '#fdf3ff');
            ctx.fillStyle = gradient;
            drawRoundedRect(4, 4, size - 8, size - 8, 18);
            ctx.fill();
            ctx.strokeStyle = 'rgba(150,110,180,0.5)';
            ctx.lineWidth = 3;
            drawRoundedRect(4, 4, size - 8, size - 8, 18);
            ctx.stroke();

            const pipLayout = {
                1: [[0.5, 0.5]],
                2: [[0.28, 0.28], [0.72, 0.72]],
                3: [[0.28, 0.28], [0.5, 0.5], [0.72, 0.72]],
                4: [[0.28, 0.28], [0.72, 0.28], [0.28, 0.72], [0.72, 0.72]],
                5: [[0.28, 0.28], [0.72, 0.28], [0.5, 0.5], [0.28, 0.72], [0.72, 0.72]],
                6: [[0.28, 0.24], [0.72, 0.24], [0.28, 0.5], [0.72, 0.5], [0.28, 0.76], [0.72, 0.76]]
            };
            ctx.fillStyle = '#5b4a6b';
            const pipRadius = size * 0.085;
            (pipLayout[pipCount] || []).forEach(([px, py]) => {
                ctx.beginPath();
                ctx.arc(px * size, py * size, pipRadius, 0, Math.PI * 2);
                ctx.fill();
            });

            return new THREE.CanvasTexture(canvas);
        }

        // 該面朝向的世界方向向量（用於計算讓指定點數朝上所需的旋轉）
        function diceFaceVector(value) {
            const vectors = {
                1: new THREE.Vector3(0, 1, 0), 6: new THREE.Vector3(0, -1, 0),
                3: new THREE.Vector3(1, 0, 0), 4: new THREE.Vector3(-1, 0, 0),
                2: new THREE.Vector3(0, 0, 1), 5: new THREE.Vector3(0, 0, -1)
            };
            return vectors[value];
        }

        // 計算讓指定點數朝上（世界 +Y）的四元數，並加上隨機水平轉向讓畫面更自然
        function diceQuaternionForValue(value) {
            const up = new THREE.Vector3(0, 1, 0);
            const align = new THREE.Quaternion().setFromUnitVectors(diceFaceVector(value), up);
            const yaw = new THREE.Quaternion().setFromAxisAngle(up, Math.random() * Math.PI * 2);
            return yaw.multiply(align);
        }

        // 初始化 three.js 場景與兩顆骰子（僅執行一次，畫布之後會被搬移到最新的棋盤容器中）
        function initDice3D() {
            if (diceRenderer || diceInitFailed || typeof THREE === 'undefined') return;

            try {
                diceScene = new THREE.Scene();
                diceCamera = new THREE.PerspectiveCamera(35, 440 / 300, 0.1, 100);
                diceCamera.position.set(0, 3.6, 5.8);
                diceCamera.lookAt(0, -0.25, 0.3);

                diceRenderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
                diceRenderer.setClearColor(0x000000, 0);
                diceRenderer.setSize(440, 300);
                diceRenderer.domElement.style.pointerEvents = 'auto';
            } catch (e) {
                // WebGL 無法使用時（例如非常舊的瀏覽器），優雅降級：不顯示 3D 動畫，直接以點數結果繼續遊戲
                console.warn('3D 骰子初始化失敗，將略過翻滾動畫：', e);
                diceInitFailed = true;
                diceRenderer = null;
                return;
            }

            diceScene.add(new THREE.AmbientLight(0xffffff, 0.8));
            const dirLight = new THREE.DirectionalLight(0xffffff, 0.6);
            dirLight.position.set(3, 6, 4);
            diceScene.add(dirLight);

            // BoxGeometry 材質順序為 [+X, -X, +Y, -Y, +Z, -Z]
            const buildMaterials = () => [
                new THREE.MeshStandardMaterial({ map: createDiceFaceTexture(DICE_VALUE_BY_AXIS.posX) }),
                new THREE.MeshStandardMaterial({ map: createDiceFaceTexture(DICE_VALUE_BY_AXIS.negX) }),
                new THREE.MeshStandardMaterial({ map: createDiceFaceTexture(DICE_VALUE_BY_AXIS.posY) }),
                new THREE.MeshStandardMaterial({ map: createDiceFaceTexture(DICE_VALUE_BY_AXIS.negY) }),
                new THREE.MeshStandardMaterial({ map: createDiceFaceTexture(DICE_VALUE_BY_AXIS.posZ) }),
                new THREE.MeshStandardMaterial({ map: createDiceFaceTexture(DICE_VALUE_BY_AXIS.negZ) })
            ];

            const geometry = new THREE.BoxGeometry(1.15, 1.15, 1.15);
            const diceA = new THREE.Mesh(geometry, buildMaterials());
            const diceB = new THREE.Mesh(geometry, buildMaterials());
            diceA.position.set(-0.9, 0, 0);
            diceB.position.set(0.9, 0, 0);
            diceScene.add(diceA, diceB);
            diceMeshes = [diceA, diceB];

            setupRollButton3D();
            renderDiceFrame();
        }

        // ===== 擲骰子：骰子本身就是按鈕（點擊 3D 骰子即擲骰）=====
        // 狀態來源仍是隱藏的 #roll-dice-btn（遊戲流程多處以 disabled 控制是否可擲骰）。
        function isRollEnabled() {
            const b = document.getElementById('roll-dice-btn');
            return !!b && !b.disabled;
        }

        function createDiceHintTexture() {
            const w = 512, h = 128;
            const c = document.createElement('canvas'); c.width = w; c.height = h;
            const g = c.getContext('2d');
            g.fillStyle = 'rgba(91,74,107,0.88)';
            g.beginPath();
            if (g.roundRect) g.roundRect(8, 14, w - 16, h - 28, 50); else g.rect(8, 14, w - 16, h - 28);
            g.fill();
            g.fillStyle = '#ffffff';
            g.font = "800 54px 'Noto Sans TC','PingFang TC','Microsoft JhengHei',sans-serif";
            g.textAlign = 'center'; g.textBaseline = 'middle';
            g.fillText('👆 點骰子擲骰', w / 2, h / 2 + 3);
            const t = new THREE.CanvasTexture(c); t.anisotropy = 4;
            return t;
        }

        function setupRollButton3D() {
            // 提示標籤（可擲骰時顯示，擲骰中淡出）
            const mat = new THREE.SpriteMaterial({ map: createDiceHintTexture(), transparent: true, depthTest: false });
            diceRollBtn = new THREE.Sprite(mat);
            diceRollBtn.scale.set(2.5, 0.625, 1);
            diceRollBtn.position.set(0, -1.15, 1.0);
            diceScene.add(diceRollBtn);

            diceRaycaster = new THREE.Raycaster();
            const el = diceRenderer.domElement;
            el.classList.add('dice-interactive');
            el.setAttribute('role', 'button');
            el.setAttribute('tabindex', '0');
            el.setAttribute('aria-label', '點擊骰子擲骰');

            const hit = (ev) => {
                const r = el.getBoundingClientRect();
                const ndc = new THREE.Vector2(((ev.clientX - r.left) / r.width) * 2 - 1, -((ev.clientY - r.top) / r.height) * 2 + 1);
                diceRaycaster.setFromCamera(ndc, diceCamera);
                return diceRaycaster.intersectObjects(diceMeshes, false).length > 0;
            };
            const doRoll = () => {
                if (!isRollEnabled() || diceAnimating) return;
                dicePressUntil = performance.now() + 160;
                document.getElementById('roll-dice-btn').click();
            };
            el.addEventListener('pointermove', (ev) => {
                diceHover = hit(ev);
                el.style.cursor = (diceHover && isRollEnabled() && !diceAnimating) ? 'pointer' : 'default';
            });
            el.addEventListener('pointerleave', () => { diceHover = false; el.style.cursor = 'default'; });
            el.addEventListener('click', (ev) => { if (hit(ev)) doRoll(); });
            el.addEventListener('keydown', (ev) => {
                if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); doRoll(); }
            });
            requestAnimationFrame(diceIdleTick);
        }

        // 閒置動畫：可擲骰時兩顆骰子輕輕跳動、滑過時放大發亮；不可擲時安靜停住
        function diceIdleTick(now) {
            requestAnimationFrame(diceIdleTick);
            if (!diceRenderer || !diceRollBtn || diceAnimating) return;
            const el = diceRenderer.domElement;
            if (!el.isConnected || el.offsetParent === null) return;
            const enabled = isRollEnabled();
            const pressed = now < dicePressUntil;
            diceMeshes.forEach((m, i) => {
                const k = !enabled ? 1 : pressed ? 0.9 : diceHover ? 1.12 : 1 + 0.03 * Math.sin(now / 280 + i * 1.3);
                m.scale.setScalar(k);
                m.position.y = enabled && !pressed ? Math.abs(Math.sin(now / 420 + i * 1.3)) * (diceHover ? 0.22 : 0.12) : 0;
                const glow = enabled && diceHover ? 0x18142e : 0x000000;
                m.material.forEach(mm => mm.emissive.setHex(glow));
            });
            diceRollBtn.material.opacity += ((enabled ? 1 : 0) - diceRollBtn.material.opacity) * 0.2;
            renderDiceFrame();
        }

        function renderDiceFrame() {
            if (diceRenderer) diceRenderer.render(diceScene, diceCamera);
        }

        // 確保 three.js 畫布已初始化並掛載到目前的 #dice3d-container（該容器會隨 drawBoard() 重建），
        // 供「一進入遊戲畫面就顯示骰子」與每次翻滾動畫共用。
        function ensureDice3DAttached() {
            initDice3D();
            if (!diceRenderer) {
                const container = document.getElementById('dice3d-container');
                if (container) {
                    container.classList.add('farm-fallback-dice');
                    const positions = {1:[4],2:[0,8],3:[0,4,8],4:[0,2,6,8],5:[0,2,4,6,8],6:[0,2,3,5,6,8]};
                    container.innerHTML = (gameState.dice || [1,6]).map((v,i) => {
                        const value = v || (i===0?1:6);
                        return `<div class="farm-die" role="img" aria-label="骰子 ${value} 點">${Array.from({length:9},(_,p)=>`<span class="${positions[value].includes(p)?'farm-pip':''}"></span>`).join('')}</div>`;
                    }).join('');
                }
                const fb = document.getElementById('roll-dice-btn'); if (fb) fb.classList.remove('hidden-by-3d');
                return false;
            } // Fallback shows the actual roll when WebGL is unavailable.
            { const hb = document.getElementById('roll-dice-btn'); if (hb) hb.classList.add('hidden-by-3d'); }

            const container = document.getElementById('dice3d-container');
            if (container && diceRenderer.domElement.parentElement !== container) {
                container.appendChild(diceRenderer.domElement);
            }
            renderDiceFrame();
            return true;
        }

        // 播放翻滾動畫，結束時停在 finalValues 對應的點數並呼叫 onComplete
        function animateDice3D(finalValues, onComplete) {
            if (!ensureDice3DAttached()) { onComplete(); return; } // three.js 載入失敗時直接跳過動畫，不影響遊戲邏輯

            diceAnimating = true;
            diceMeshes.forEach(m => { m.scale.setScalar(1); m.position.y = 0; m.material.forEach(mm => mm.emissive.setHex(0x000000)); });
            if (diceRollBtn) diceRollBtn.material.opacity = 0;
            const tumbleDuration = 900; // 翻滾時間 (ms)
            const settleDuration = 350; // 收斂到最終點數的時間 (ms)
            const spin = diceMeshes.map(() => ({
                x: (Math.random() * 4 + 4) * (Math.random() < 0.5 ? -1 : 1),
                y: (Math.random() * 4 + 4) * (Math.random() < 0.5 ? -1 : 1),
                z: (Math.random() * 4 + 4) * (Math.random() < 0.5 ? -1 : 1)
            }));
            const baseY = diceMeshes.map(m => m.position.y);
            const bouncePhase = diceMeshes.map(() => Math.random() * Math.PI * 2);

            const startTime = performance.now();
            let lastTime = startTime;
            let settling = false, settleStartQuats = null, targetQuats = null;

            function tick(now) {
                const dt = Math.min(0.05, (now - lastTime) / 1000);
                lastTime = now;
                const elapsed = now - startTime;

                if (elapsed < tumbleDuration) {
                    const progress = elapsed / tumbleDuration;
                    const damping = 1 - progress * 0.4; // 逐漸減速，模擬骰子即將停止
                    diceMeshes.forEach((mesh, i) => {
                        mesh.rotation.x += spin[i].x * dt * damping;
                        mesh.rotation.y += spin[i].y * dt * damping;
                        mesh.rotation.z += spin[i].z * dt * damping;
                        mesh.position.y = baseY[i] + Math.abs(Math.sin(elapsed / 100 + bouncePhase[i])) * 0.5 * (1 - progress);
                    });
                    renderDiceFrame();
                    requestAnimationFrame(tick);
                } else {
                    if (!settling) {
                        settling = true;
                        settleStartQuats = diceMeshes.map(m => m.quaternion.clone());
                        targetQuats = finalValues.map(v => diceQuaternionForValue(v));
                    }
                    const t = Math.min(1, (elapsed - tumbleDuration) / settleDuration);
                    const eased = 1 - Math.pow(1 - t, 3); // ease-out，讓收斂更自然
                    diceMeshes.forEach((mesh, i) => {
                        mesh.quaternion.copy(settleStartQuats[i]).slerp(targetQuats[i], eased);
                        mesh.position.y = baseY[i] * eased + mesh.position.y * (1 - eased);
                    });
                    renderDiceFrame();
                    if (t < 1) {
                        requestAnimationFrame(tick);
                    } else {
                        diceMeshes.forEach((mesh, i) => { mesh.position.y = baseY[i]; });
                        renderDiceFrame();
                        soundManager.playDiceLand();
                        diceAnimating = false;
                        onComplete();
                    }
                }
            }
            requestAnimationFrame(tick);
        }

        // Roll the dice and move the player
        function rollDice() {
            document.getElementById('roll-dice-btn').disabled = true;
            soundManager.playDiceRoll();

            const value1 = Math.floor(Math.random() * 6) + 1;
            const value2 = Math.floor(Math.random() * 6) + 1;
            gameState.dice[0] = value1;
            gameState.dice[1] = value2;

            animateDice3D([value1, value2], () => {
                movePlayer(value1 + value2);
            });
        }
        // Move the player step by step
        async function movePlayer(steps) {
            const player = gameState.players[gameState.currentPlayerIndex];
            if (player.inJail) {
                if (gameState.dice[0] === gameState.dice[1]) {
                    player.inJail = false;
                    player.jailTurns = 0;
                    soundManager.playGetOutOfJail();
                    showMessage("擲出雙倍！你自由了！", () => movePlayer(steps)); // Recurse move for double
                } else {
                    showMessage("在監獄中，擲骰失敗。", () => endTurn(false)); // Lost turn in jail
                }
                return;
            }
            const oldPosition = player.position;
            for (let i = 1; i <= steps; i++) {
                player.position = (oldPosition + i) % gameState.board.length;
                updatePlayerPawns();
                soundManager.playStep(i);
                await new Promise(res => setTimeout(res, 100)); // Short delay for visual movement
            }
            // Check if player passed Go (start)
            if (player.position < oldPosition) {
                applyMoneyChange(player, 2000, '經過「起點」，領取薪水', 'salary');
                drawPlayerInfo();
                soundManager.playPassGo();
                showAIToast('經過「起點」，領取薪水 $2000！', 'success', 3000);
            }
            setTimeout(() => handleSpaceAction(player.position, true), 200); // Pass true to indicate first land on space
        }

        // Handles actions based on the space the player landed on
        // `isFirstLand` indicates if this is the initial landing or a consequence of a card/jail release
        function handleSpaceAction(position, isFirstLand = false) {
            const space = gameState.board[position];
            const player = gameState.players[gameState.currentPlayerIndex];

            const hasActiveQuizzes = gameState.activeQuizBanks.length > 0;

            // Conditions that should *NEVER* trigger a quiz, directly perform space action
            const skipQuizDirectly = ['tax', 'goToJail', 'jail'].includes(space.type) || // Punishment spaces
                (['property', 'station', 'utility'].includes(space.type) && space.ownerId !== null); // Owned by anyone (including current player)

            // Logic for when to show a quiz
            if (isFirstLand && hasActiveQuizzes && !skipQuizDirectly) {
                // These are the spaces that *should* trigger a quiz IF conditions above are met
                // This includes: unowned properties, go, parking, chance, destiny
                showQuizModal(space, position); // Quiz modal handles its own callback to performSpaceActionAfterQuiz or endTurn
            } else {
                // No quiz, proceed directly with space action (e.g., punishment spaces, owned properties, or no quizzes active)
                performSpaceActionAfterQuiz(space, position); // performSpaceActionAfterQuiz will call endTurn
            }
            checkBankruptcy(); // Check for bankruptcy after every action
        }

        // Performs the actual action for the space after a potential quiz (or if no quiz was triggered)
        function performSpaceActionAfterQuiz(space, position) {
            const player = gameState.players[gameState.currentPlayerIndex];
            switch (space.type) {
                case 'property': case 'station': case 'utility':
                    if (space.ownerId === null) {
                        showBuyPropertyModal(space, position); // Unowned, offer to buy. This modal will call endTurn().
                    } else if (space.ownerId !== player.id) {
                        payRent(space, position); // Owned by another player, pay rent. This will call endTurn().
                    } else { // Owned by current player
                        endTurn(true); // Do nothing, just end turn (valid action)
                    }
                    break;
                case 'chance': drawCard('chance'); break; // drawCard will handle its own endTurn
                case 'destiny': drawCard('destiny'); break; // drawCard will handle its own endTurn
                case 'go':
                case 'parking':
                case 'jail': // If landing on jail (just visiting), no action
                    endTurn(true);
                    break;
                case 'tax':
                    soundManager.playPayRent();
                    applyMoneyChange(player, -space.amount, `繳交${space.name}`, 'tax');
                    showMessage(`繳交 ${space.name} $${space.amount}。`, () => { drawPlayerInfo(); endTurn(true); });
                    break;
                case 'goToJail': goToJail(); break; // goToJail will call switchPlayer
                default: endTurn(true); break;
            }
        }

        // Show Quiz Modal
        function showQuizModal(space, position) {
            const quizQuestionEl = document.getElementById('quiz-question');
            const quizOptionsEls = document.querySelectorAll('#quiz-options .quiz-option-btn');
            const quizFeedbackEl = document.getElementById('quiz-feedback');
            const quizOkBtn = document.getElementById('quiz-ok-btn');

            const farmCompanion = document.getElementById('farm-quiz-companion');
            const guardian = Number.isInteger(space.farmSpriteIndex) ? FARM_SPRITES[space.farmSpriteIndex] : FARM_SPRITES.find(s => s.emoji === gameState.players[gameState.currentPlayerIndex].emoji);
            farmCompanion.innerHTML = farmImage(guardian) + `<span>${guardian ? guardian.name + '精靈' : '農精靈'}陪你想一想</span>`;
            quizFeedbackEl.classList.add('hidden');
            quizOkBtn.classList.add('hidden'); // Hide until answer is given
            quizOptionsEls.forEach(btn => {
                btn.classList.remove('correct', 'incorrect', 'opacity-50', 'cursor-not-allowed');
                btn.disabled = false; // Enable all options
            });

            // Collect all available questions from active quiz banks
            let allActiveQuestionsWithBankInfo = [];
            gameState.activeQuizBanks.forEach(bankName => {
                if (gameState.quizzes[bankName] && gameState.availableQuizIndices[bankName]) {
                    gameState.availableQuizIndices[bankName].forEach(qIndex => {
                        allActiveQuestionsWithBankInfo.push({
                            question: gameState.quizzes[bankName][qIndex],
                            bankName: bankName,
                            qIndex: qIndex
                        });
                    });
                }
            });

            // If all questions are used, reset the available pools for all active banks
            if (allActiveQuestionsWithBankInfo.length === 0) {
                gameState.activeQuizBanks.forEach(bankName => {
                    if (gameState.quizzes[bankName]) {
                        gameState.availableQuizIndices[bankName] = Array.from({ length: gameState.quizzes[bankName].length }, (_, i) => i);
                    }
                });
                // After resetting, re-populate allActiveQuestionsWithBankInfo
                gameState.activeQuizBanks.forEach(bankName => {
                    if (gameState.quizzes[bankName] && gameState.availableQuizIndices[bankName]) {
                        gameState.availableQuizIndices[bankName].forEach(qIndex => {
                            allActiveQuestionsWithBankInfo.push({
                                question: gameState.quizzes[bankName][qIndex],
                                bankName: bankName,
                                qIndex: qIndex
                            });
                        });
                    }
                });
            }

            if (allActiveQuestionsWithBankInfo.length === 0) {
                showMessage('沒有可用的題目。', () => performSpaceActionAfterQuiz(space, position));
                return;
            }

            // Balance values: choose among the banks asked the fewest times this cycle.
            // Each of the 16 values appears once per 16 questions; all 48 precede repeats.
            const availableBanks = [...new Set(allActiveQuestionsWithBankInfo.map(q => q.bankName))];
            const usedCount = name => gameState.quizzes[name].length - gameState.availableQuizIndices[name].length;
            const leastUsed = Math.min(...availableBanks.map(usedCount));
            const balancedPool = allActiveQuestionsWithBankInfo.filter(q => usedCount(q.bankName) === leastUsed);
            const randomIndex = Math.floor(Math.random() * balancedPool.length);
            const { question: randomQuestionData, bankName: pickedBank, qIndex: pickedIndex } = balancedPool[randomIndex];

            // Remove the picked question from the available pool
            // Filter creates a new array, assign it back
            gameState.availableQuizIndices[pickedBank] = gameState.availableQuizIndices[pickedBank].filter(idx => idx !== pickedIndex);


            document.getElementById('quiz-source-label').textContent = randomQuestionData.sourceId ? `品德情境挑戰 · 第 ${randomQuestionData.sourceId} 題` : '情境挑戰';
            zySet(quizQuestionEl, randomQuestionData.question); zyLabel(); TTS.refresh();
            randomQuestionData.options.forEach((optionText, index) => {
                zySet(quizOptionsEls[index], optionText);
                quizOptionsEls[index].onclick = () => {
                    // Disable all options after one is clicked
                    quizOptionsEls.forEach(btn => {
                        btn.disabled = true;
                        btn.classList.add('opacity-50', 'cursor-not-allowed');
                    });

                    if (index === randomQuestionData.answer) {
                        soundManager.playQuizCorrect();
                        zySet(quizFeedbackEl, '恭喜你，答對了！' + (randomQuestionData.explanation ? '\n' + randomQuestionData.explanation : ''));
                        quizFeedbackEl.classList.remove('text-red-600');
                        quizFeedbackEl.classList.add('text-green-600');
                        quizOptionsEls[index].classList.add('correct');

                        quizOkBtn.onclick = () => {
                            closeSpecificModal(quizModal);
                            // If correct, proceed with the original space action
                            performSpaceActionAfterQuiz(space, position);
                        };
                    } else {
                        soundManager.playQuizWrong();
                        zySet(quizFeedbackEl, `答錯了。正確答案是：${randomQuestionData.options[randomQuestionData.answer]}` + (randomQuestionData.explanation ? "\n" + randomQuestionData.explanation : ""));
                        quizFeedbackEl.classList.remove('text-green-600');
                        quizFeedbackEl.classList.add('text-red-600');
                        quizOptionsEls[index].classList.add('incorrect');
                        quizOptionsEls[randomQuestionData.answer].classList.add('correct'); // Highlight correct answer

                        quizOkBtn.onclick = () => {
                            closeSpecificModal(quizModal);
                            // If incorrect, skip the action and just proceed to next turn (always switch player)
                            showMessage('你答錯了！無法進行此格子的操作。', () => endTurn(false));
                        };
                    }
                    quizFeedbackEl.classList.remove('hidden');
                    quizOkBtn.classList.remove('hidden'); // Show continue button
                };
            });
            modalContainer.classList.remove('hidden');
            quizModal.classList.remove('hidden');
            if (TTS.auto) setTimeout(() => TTS.say(document.getElementById('quiz-question').dataset.raw + (Array.from(document.querySelectorAll('#quiz-modal .quiz-option-btn')).map((b, i) => '。選項' + '一二三四'[i] + '，' + b.dataset.raw).join(''))), 250);
        }

        // Calculate and pay rent
        function payRent(space, position) {
            const owner = gameState.players.find(p => p.id === space.ownerId);
            if (!owner) { endTurn(true); return; }
            let rent = 0;
            if (space.type === 'property') rent = space.rent;
            else if (space.type === 'station') {
                // Rent for stations increases based on how many stations the owner has
                const count = gameState.board.filter(s => s.type === 'station' && s.ownerId === owner.id).length;
                rent = space.rent * Math.pow(2, count - 1);
            } else if (space.type === 'utility') {
                // Rent for utilities depends on dice roll and number of utilities owned
                const count = gameState.board.filter(s => s.type === 'utility' && s.ownerId === owner.id).length;
                rent = (gameState.dice[0] + gameState.dice[1]) * (count === 1 ? 40 : 100);
            }
            const player = gameState.players[gameState.currentPlayerIndex];
            applyMoneyChange(player, -rent, `支付租金給 ${owner.name}（${space.name}）`, 'rent_expense', owner.id);
            applyMoneyChange(owner, rent, `${player.name} 支付的租金（${space.name}）`, 'rent_income', player.id);
            soundManager.playPayRent();
            showMessage(`降落在 ${owner.name} 的 ${space.name}，支付租金 $${rent}。`, () => { drawPlayerInfo(); checkBankruptcy(); endTurn(true); });
        }
        // Send player to jail
        function goToJail() {
            const player = gameState.players[gameState.currentPlayerIndex];
            player.position = 10; // Jail space index
            player.inJail = true;
            player.jailTurns = 0; // Reset jail turns
            soundManager.playGoToJail();
            updatePlayerPawns();
            updateJailStatusDisplay(); // Update jail status display after going to jail
            showMessage('你被送進監獄了！', switchPlayer); // Always switch player after going to jail
        }
        // Handle player's turn while in jail
        function handleJailTurn() {
            const player = gameState.players[gameState.currentPlayerIndex];
            player.jailTurns++;
            drawPlayerInfo(); // Update player info to show jail turns
            updateJailStatusDisplay(); // Update jail status display
            if (player.getOutOfJailCards > 0) {
                // Use a Get Out of Jail Free card
                player.getOutOfJailCards--;
                player.inJail = false;
                player.jailTurns = 0;
                soundManager.playGetOutOfJail();
                showMessage(`使用了「免費出獄卡」，可以再擲一次！`, () => { updateJailStatusDisplay(); endTurn(true); }); // Valid action, player can roll again
            } else if (player.jailTurns > 3) {
                // After 3 turns, pay bail
                applyMoneyChange(player, -500, '監獄保釋金', 'jail');
                player.inJail = false;
                player.jailTurns = 0;
                soundManager.playGetOutOfJail();
                showMessage(`已在監獄待3回合，支付 $500 保釋金。`, () => { updateJailStatusDisplay(); drawPlayerInfo(); endTurn(true); }); // Valid action, player can roll again
            } else {
                // Still in jail, skip turn
                showMessage(`你在監獄中，還剩下 ${4 - player.jailTurns} 回合。`, switchPlayer); // Invalid action, skip to next player
            }
            saveGameState();
        }
        // Draw and process a Chance or Destiny card
        function drawCard(type) {
            const cardDeck = type === 'chance' ? (gameState.chanceCards || chanceCards) : (gameState.destinyCards || destinyCards);
            if (!cardDeck || cardDeck.length === 0) { endTurn(true); return; }
            const card = cardDeck[Math.floor(Math.random() * cardDeck.length)];
            soundManager.playCardDraw();
            showCardModal(type, card.text, () => handleCardAction(card)); // Card modal calls handleCardAction
        }
        // Perform action specified by the card
        function handleCardAction(card) {
            const player = gameState.players[gameState.currentPlayerIndex];
            switch (card.action) {
                case 'money': applyMoneyChange(player, card.amount, card.text, 'card'); drawPlayerInfo(); endTurn(true); break;
                // For move actions from cards, we don't trigger quiz again, pass isFirstLand = false
                case 'move': player.position = card.position; if (player.position === 0) applyMoneyChange(player, 2000, '經過「起點」，領取薪水', 'salary'); updatePlayerPawns(); handleSpaceAction(player.position, false); break;
                case 'moveRelative': // For relative move actions from cards, we don't trigger quiz again
                    const oldPosForRelativeMove = player.position;
                    player.position = (player.position + card.amount) % gameState.board.length;
                    if (player.position < oldPosForRelativeMove && card.amount > 0) { // Check if passed Go
                        applyMoneyChange(player, 2000, '經過「起點」，領取薪水', 'salary');
                        drawPlayerInfo();
                        showAIToast('經過「起點」，領取薪水 $2000！', 'success', 3000);
                    }
                    updatePlayerPawns();
                    handleSpaceAction(player.position, false); // No quiz after card move
                    break;
                case 'goToJail': goToJail(); break; // goToJail handles its own switchPlayer
                case 'getOutOfJail': player.getOutOfJailCards++; endTurn(true); break;
            }
            checkBankruptcy();
        }
        // Check if any player is bankrupt and end game if only one player remains
        function checkBankruptcy() {
            // Filter out bankrupt players
            const remainingPlayers = gameState.players.filter(p => p.money >= 0);

            // If only one or zero players remain, end the game.
            if (remainingPlayers.length <= 1 && !gameState.isGameOver) {
                // Show bankruptcy message for newly bankrupt players before ending
                gameState.players.forEach(player => {
                    if (player.money < 0 && !player.announcedBankruptcy) {
                        player.announcedBankruptcy = true; // Mark as announced to prevent repeated messages
                        soundManager.playBankruptcy();
                        showMessage(`${player.name} 破產了！`, () => {
                            gameState.board.forEach(space => { if (space.ownerId === player.id) space.ownerId = null; });
                            drawBoard(); // Redraw board to reflect ownership changes
                            // After message, recheck and potentially end game
                            if (gameState.players.filter(p => p.money >= 0).length <= 1) {
                                endGame();
                            }
                        });
                    }
                });
                // If the condition still holds (all bankrupt or only one left), end the game
                if (remainingPlayers.length <= 1) {
                    endGame();
                }
            } else {
                // For any players who just went bankrupt, but the game is not yet over (more than one active player left)
                gameState.players.forEach(player => {
                    if (player.money < 0 && !player.announcedBankruptcy) {
                        player.announcedBankruptcy = true;
                        soundManager.playBankruptcy();
                        showMessage(`${player.name} 破產了！`, () => {
                            gameState.board.forEach(space => { if (space.ownerId === player.id) space.ownerId = null; });
                            drawBoard();
                            // After message, if current player is bankrupt, switch to next valid player
                            if (gameState.players[gameState.currentPlayerIndex].money < 0) {
                                switchPlayer();
                            }
                        });
                    }
                });
            }
        }

        // Save game state to local storage
        function saveGameState() {
            if (!gameState.isGameOver) {
                // Save the entire gameState object including current gameTitle and the full board.
                // The board array within gameState already contains the themed names/prices if AI was used.
                safeLS.setItem('yunlin_character_monopoly_farm_v2', JSON.stringify(gameState));
            }
        }

        // Load game state from local storage or show setup screen
        function loadGame() {
            const savedGame = safeLS.getItem('yunlin_character_monopoly_farm_v2');
            const exportBtn = document.getElementById('export-game-btn');
            const importBtn = document.getElementById('import-game-btn');

            if (savedGame) {
                try {
                    const loadedState = JSON.parse(savedGame);

                    // Directly use loadedState.board as the game board
                    // Ensure all necessary properties exist, providing fallbacks
