        #setup-screen::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 100% 0%, rgba(255, 214, 232, 0.55), transparent 55%),
                radial-gradient(circle at 0% 100%, rgba(205, 234, 255, 0.55), transparent 55%);
            pointer-events: none;
        }

        #setup-screen>* {
            position: relative;
            z-index: 1;
        }

        #setup-screen h1 {
            background: linear-gradient(90deg, var(--macaron-pink-deep), var(--macaron-lavender-deep));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        #setup-screen select,
        #setup-screen input[type="text"],
        #setup-screen input[type="number"],
