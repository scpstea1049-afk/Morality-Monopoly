<script>
// ===== 注音標示（題目文字用）：國字右側直式注音 =====
const ZhuyinLib = (() => {
    const charMap = new Map(), phrMap = new Map();
    ZY_CHARS.replace(/([\u4e00-\u9fff])([^\u4e00-\u9fff]+)/g, (m, c, z) => { charMap.set(c, z); return m; });
    ZY_PHRASES.split(';').forEach(e => { const i = e.indexOf(':'); if (i > 0) phrMap.set(e.slice(0, i), e.slice(i + 1).split(' ')); });
    const CJK = /[\u4e00-\u9fff]/;
    const esc = t => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    // 直式注音：符號由上而下疊在國字右側（ㄧ 維持橫的）；聲調符號在右側中間，輕聲點在上方
    function ruby(c, z) {
        if (!z) return esc(c);
        let tone = '';
        const last = z.charAt(z.length - 1);
        if ('ˊˇˋ˙'.includes(last)) { tone = last; z = z.slice(0, -1); }
        return '<span class="zy"><span class="zh">' + c + '</span><span class="zp"><span class="zl">' +
            [...z].map(l => '<i>' + l + '</i>').join('') + '</span>' +
            (tone ? '<span class="zt' + (tone === '˙' ? ' neu' : '') + '">' + tone + '</span>' : '') + '</span></span>';
    }
    function html(text) {
        text = String(text == null ? '' : text);
        let out = '', i = 0;
        while (i < text.length) {
            const c = text[i];
            if (!CJK.test(c)) { out += esc(c); i++; continue; }
            let done = false;
            for (let n = Math.min(4, text.length - i); n >= 2 && !done; n--) {
                const w = text.substr(i, n), sy = phrMap.get(w);
                if (sy && sy.length === n && [...w].every(ch => CJK.test(ch))) {
                    for (let k = 0; k < n; k++) out += ruby(w[k], sy[k]);
                    i += n; done = true;
                }
            }
            if (done) continue;
            const z = charMap.get(c);
            out += z ? ruby(c, z) : esc(c);
            i++;
        }
        return out;
    }
    return { html };
})();

// 題目視窗：依「注音」開關顯示（記在瀏覽器；不可用時預設開啟）
let zhuyinOn = true;
try { if (safeLS.getItem('zhuyinOn') === '0') zhuyinOn = false; } catch (e) { }
function zySet(el, text) {
    if (!el) return;
    el.dataset.raw = text;
    if (el.id === 'quiz-feedback' && TTS.auto) TTS.say(text);
    if (zhuyinOn) { el.innerHTML = ZhuyinLib.html(text); el.classList.add('zy-on'); }
    else { el.textContent = text; el.classList.remove('zy-on'); }
}
function zyToggle() {
    zhuyinOn = !zhuyinOn;
    try { safeLS.setItem('zhuyinOn', zhuyinOn ? '1' : '0'); } catch (e) { }
    document.querySelectorAll('#quiz-modal [data-raw]').forEach(el => zySet(el, el.dataset.raw));
    zyLabel();
}
function zyLabel() {
    const b = document.getElementById('zhuyin-toggle-btn');
    if (b) { b.textContent = 'ㄅㄆㄇ 注音：' + (zhuyinOn ? '開' : '關'); b.classList.toggle('off', !zhuyinOn); }
}

// ===== 語音唸題目（瀏覽器內建語音，不需網路服務）=====
const TTS = (() => {
    const ok = 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window;
    let voice = null, speaking = false, autoRead = false;
    try { autoRead = safeLS.getItem('ttsAuto') === '1'; } catch (e) { }
    function pickVoice() {
        if (!ok) return;
        const vs = speechSynthesis.getVoices();
        const score = v => { const l = (v.lang || '').replace('_', '-').toLowerCase();
            return l === 'zh-tw' ? 3 : (l.startsWith('zh-hant') ? 3 : (l.startsWith('zh') && !l.includes('cn') && !l.includes('hk') ? 2 : (l.startsWith('zh') ? 1 : 0))); };
        voice = vs.slice().sort((a, b) => score(b) - score(a))[0] || null;
        if (voice && score(voice) === 0) voice = null;
    }
    if (ok) { pickVoice(); speechSynthesis.onvoiceschanged = pickVoice; }
    function setBtn() {
        const b = document.getElementById('tts-btn');
        if (b) b.textContent = speaking ? '⏹ 停止' : '🔊 唸題目';
        const a = document.getElementById('tts-auto-btn');
        if (a) { a.textContent = '自動唸：' + (autoRead ? '開' : '關'); a.classList.toggle('off', !autoRead); }
    }
    function stop() { if (!ok) return; speechSynthesis.cancel(); speaking = false; setBtn(); }
    function say(text) {
        if (!ok || !text) return;
        speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(String(text).replace(/\s*\n\s*/g, '。'));
        u.lang = 'zh-TW'; if (voice) u.voice = voice;
        u.rate = 0.9; u.pitch = 1.05;
        u.onend = u.onerror = () => { speaking = false; setBtn(); };
        speaking = true; setBtn();
        speechSynthesis.speak(u);
    }
    const NUM = ['一', '二', '三', '四', '五', '六'];
    function quizText() {
        const q = document.getElementById('quiz-question');
        let t = q && q.dataset.raw ? q.dataset.raw : '';
        const opts = Array.from(document.querySelectorAll('#quiz-modal .quiz-option-btn')).filter(b => b.dataset.raw);
        opts.forEach((b, i) => { t += '。選項' + NUM[i] + '，' + b.dataset.raw; });
        return t;
    }
    return {
        ok, stop, say,
        toggleRead() { if (speaking) stop(); else say(quizText()); },
        toggleAuto() { autoRead = !autoRead; try { safeLS.setItem('ttsAuto', autoRead ? '1' : '0'); } catch (e) { } setBtn(); if (autoRead && !speaking) say(quizText()); else if (!autoRead) stop(); },
        get auto() { return autoRead; },
        refresh: setBtn
    };
})();
</script>


