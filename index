            // 租金收入來源統計：從哪個玩家處收到最多租金
            const rentBySource = {};
            transactions.forEach(t => {
                if (t.type === 'rent_income' && t.counterpartyId !== null && t.counterpartyId !== undefined) {
                    if (!rentBySource[t.counterpartyId]) rentBySource[t.counterpartyId] = { total: 0, count: 0 };
                    rentBySource[t.counterpartyId].total += t.amount;
                    rentBySource[t.counterpartyId].count += 1;
                }
            });
            const rentSourceEntries = Object.entries(rentBySource)
                .map(([pid, data]) => {
                    const sourcePlayer = gameState.players.find(p => p.id === parseInt(pid));
                    return { id: parseInt(pid), ...data, name: sourcePlayer ? `${sourcePlayer.emoji} ${sourcePlayer.name}` : '未知玩家' };
                })
                .sort((a, b) => b.total - a.total);

            const rentSourceHTML = rentSourceEntries.length
                ? `<div class="ph-rent-source-list">${rentSourceEntries.map((r, idx) => `
                        <div class="ph-rent-source-row ${idx === 0 ? 'ph-top-source' : ''}">
                            <span>${idx === 0 ? '🏆 ' : ''}${r.name}</span>
                            <span>$${r.total.toLocaleString()}（${r.count} 次）</span>
                        </div>`).join('')}</div>`
                : '<p class="ph-empty">尚未從其他玩家處收取租金。</p>';

            // 完整收支歷程（最新在前）
            const historyHTML = transactions.length
                ? [...transactions].reverse().map(t => {
