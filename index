        // --- 地圖區／玩家資訊區：可拖曳調整寬度比例 ---
        function initPaneResizer() {
            const resizer = document.getElementById('pane-resizer');
            const boardPane = document.getElementById('board-pane');
            const sidebarPane = document.getElementById('sidebar-pane');
            const row = document.querySelector('.game-main-row');
            if (!resizer || !boardPane || !sidebarPane || !row) return;

            let dragging = false;

            const getClientX = (e) => (e.touches ? e.touches[0].clientX : e.clientX);

            function onDragStart(e) {
                if (window.innerWidth < 768) return; // 手機為上下堆疊版面，不提供拖曳調整
                dragging = true;
                resizer.classList.add('dragging');
                document.body.style.userSelect = 'none';
                document.body.style.cursor = 'col-resize';
                e.preventDefault();
            }

            function onDragMove(e) {
                if (!dragging) return;
                const rowRect = row.getBoundingClientRect();
                let boardPercent = ((getClientX(e) - rowRect.left) / rowRect.width) * 100;
                boardPercent = Math.max(40, Math.min(85, boardPercent)); // 限制拖曳範圍，避免任一側過窄
                boardPane.style.flex = `0 0 ${boardPercent}%`;
                sidebarPane.style.flex = `0 0 ${100 - boardPercent}%`;
                e.preventDefault();
            }

            function onDragEnd() {
                if (!dragging) return;
                dragging = false;
                resizer.classList.remove('dragging');
                document.body.style.userSelect = '';
                document.body.style.cursor = '';
            }

            resizer.addEventListener('mousedown', onDragStart);
            resizer.addEventListener('touchstart', onDragStart, { passive: false });
            window.addEventListener('mousemove', onDragMove);
            window.addEventListener('touchmove', onDragMove, { passive: false });
            window.addEventListener('mouseup', onDragEnd);
            window.addEventListener('touchend', onDragEnd);
        }
        initPaneResizer();

