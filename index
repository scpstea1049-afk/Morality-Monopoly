            showAIToast('AI 正在生成卡片，請稍候...', 'loading');
            try {
                const prompt = `您是一個大富翁遊戲設計師。請為「${theme}」主題的大富翁遊戲生成機會和命運卡片。\n\n請以 JSON 格式回傳，action 必須是 "money"、"move"、"moveRelative"、"goToJail"、"getOutOfJail" 之一：\n{\n  "chanceCards": [\n    { "text": "中了樂透，獲得 $2000。", "action": "money", "amount": 2000 },\n    { "text": "前進到起點，領取薪水。", "action": "move", "position": 0 },\n    { "text": "免費出獄卡。", "action": "getOutOfJail" },\n    { "text": "前進三步。", "action": "moveRelative", "amount": 3 }\n  ],\n  "destinyCards": [\n    { "text": "被罰款 $500。", "action": "money", "amount": -500 },\n    { "text": "直接入獄。", "action": "goToJail" }\n  ]\n}\n\n要求：\n- chanceCards 生成 6~8 張，內容與「${theme}」主題相關，正面事件為主\n- destinyCards 生成 6~8 張，內容與「${theme}」主題相關，混合正負面事件\n- money action 的 amount 正數為獲得，負數為支出\n- move action 必須有 position (0-39 的格子索引)\n- moveRelative action 必須有 amount (步數)`;
                let aiData;
                let response;

                if (selectedModelType === 'ollama-local') {
                    const payload = {
                        model: modelName,
                        messages: [{ role: "user", content: prompt }],
                        format: "json",
                        stream: false
                    };
                    response = await fetch(`${ollamaUrl}/api/chat`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                    if (!response.ok) {
                        throw new Error(`Ollama 回應錯誤 HTTP ${response.status}`);
                    }
                    const result = await response.json();
                    if (result.message && result.message.content) {
                        aiData = JSON.parse(result.message.content);
                    } else {
                        throw new Error("Ollama 回應格式不正確或沒有內容。");
                    }
                } else {
                    const payload = {
                        contents: [{ parts: [{ text: prompt }] }],
                        generationConfig: { responseMimeType: "application/json" }
                    };

                    let fetchUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
                    if (selectedModelType === 'gemini-api-key') {
                        const userKey = geminiApiKeyInput.value.trim();
                        if (!userKey) {
                            throw new Error("請先設定 API Key！");
                        }
                        fetchUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${userKey}`;
                    }

                    const delays = [1000, 2000, 4000, 8000, 16000];
                    let data = null;
                    let lastError = null;

                    for (let i = 0; i <= delays.length; i++) {
                        try {
                            const response = await fetch(fetchUrl, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(payload)
                            });

                            if (!response.ok) {
                                const errData = await response.json().catch(() => ({}));
                                throw new Error(errData.error?.message || `HTTP 狀態碼 ${response.status}`);
                            }

                            data = await response.json();
                            break;
                        } catch (err) {
                            lastError = err;
                            if (i < delays.length) {
                                await new Promise(resolve => setTimeout(resolve, delays[i]));
                            }
                        }
                    }

                    if (!data) {
                        throw new Error("API 請求多次失敗：" + (lastError?.message || "網路或伺服器異常"));
                    }

                    if (!data.candidates || !data.candidates[0] || !data.candidates[0].content) {
                        throw new Error("AI 回傳資料格式有誤，請重試。");
                    }

                    const textResponse = data.candidates[0].content.parts[0].text;
                    try {
                        const cleanText = textResponse.replace(/```json/gi, '').replace(/```/g, '').trim();
                        aiData = JSON.parse(cleanText);
                    } catch (e) {
                        throw new Error("AI 回傳 JSON 解析失敗，請重試。");
                    }
                }
                if (aiData.chanceCards?.length && aiData.destinyCards?.length) {
                    gameState.chanceCards = aiData.chanceCards;
                    gameState.destinyCards = aiData.destinyCards;
                    showAIToast(`卡片生成完成！機會 ${aiData.chanceCards.length} 張，命運 ${aiData.destinyCards.length} 張。`, 'success', 3000);
                } else {
                    throw new Error('AI 未能生成有效卡片。');
                }
            } catch (err) {
                console.error('AI 生成卡片錯誤:', err);
                showAIToast(`AI 生成卡片失敗: ${err.message}`, 'error', 5000);
            } finally {
                genBtn.disabled = false; loadMsg.classList.add('hidden');
            }
        }


        // --- How to Play Button Event Listener ---
        howToPlayBtn.addEventListener('click', () => {
            modalContainer.classList.remove('hidden');
            howToPlayModal.classList.remove('hidden');
        });

        // --- Quiz Edit Modal Functions ---
        addNewQuestionBtn.addEventListener('click', addNewQuestion);
        saveQuizBtn.addEventListener('click', saveQuizChanges);
        cancelQuizEditBtn.addEventListener('click', () => closeSpecificModal(modals.editQuiz));

        function showEditQuizModal(bankName) {
            editingQuizBankName = bankName;
            editQuizTitle.textContent = `編輯題庫：${bankName}`;
            quizEditorList.innerHTML = ''; // Clear previous content

            // Create a deep copy of the quiz data for temporary editing
            tempEditingQuizData = JSON.parse(JSON.stringify(gameState.quizzes[bankName] || []));

            renderTempQuizData();

            modalContainer.classList.remove('hidden');
            editQuizModal.classList.remove('hidden');
        }

        function renderTempQuizData() {
            quizEditorList.innerHTML = '';
            if (tempEditingQuizData.length === 0) {
                const noQuestionsDiv = document.createElement('div');
                noQuestionsDiv.className = 'text-center text-gray-500 py-4';
                noQuestionsDiv.textContent = '此題庫目前沒有題目。';
                quizEditorList.appendChild(noQuestionsDiv);
            }

            tempEditingQuizData.forEach((quiz, index) => {
                createQuizItemEditor(quiz, index);
            });
        }

        function createQuizItemEditor(quizData, index) {
            const quizItemDiv = document.createElement('div');
            quizItemDiv.className = 'quiz-item-editor';
            quizItemDiv.dataset.index = index; // Store original index

            quizItemDiv.innerHTML = `
                <button class="delete-question-btn">刪除此題目</button>
                <label>問題 ${index + 1}:</label>
                <textarea class="question-input" rows="3" placeholder="輸入問題..."></textarea>
                <label>選項:</label>
                <div class="option-input-group">
                    <input type="text" class="option-input" data-option-index="0" placeholder="選項 1">
                </div>
                <div class="option-input-group">
                    <input type="text" class="option-input" data-option-index="1" placeholder="選項 2">
                </div>
                <div class="option-input-group">
                    <input type="text" class="option-input" data-option-index="2" placeholder="選項 3">
                </div>
                <div class="option-input-group">
                    <input type="text" class="option-input" data-option-index="3" placeholder="選項 4">
                </div>
                <label>正確答案:</label>
                <select class="correct-answer-select">
                    <option value="0">選項 1</option>
                    <option value="1">選項 2</option>
                    <option value="2">選項 3</option>
                    <option value="3">選項 4</option>
                </select>
            `;

            quizEditorList.appendChild(quizItemDiv);

            // Populate existing data
            quizItemDiv.querySelector('.question-input').value = quizData.question || '';
            quizData.options.forEach((option, i) => {
                const optionInput = quizItemDiv.querySelector(`.option-input[data-option-index="${i}"]`);
                if (optionInput) optionInput.value = option;
            });
            quizItemDiv.querySelector('.correct-answer-select').value = quizData.answer !== undefined ? String(quizData.answer) : '0';

            // Add event listeners for changes
            quizItemDiv.querySelector('.question-input').addEventListener('input', (e) => {
                tempEditingQuizData[index].question = e.target.value;
            });
            quizItemDiv.querySelectorAll('.option-input').forEach(input => {
                input.addEventListener('input', (e) => {
                    const optionIdx = parseInt(e.target.dataset.optionIndex);
                    tempEditingQuizData[index].options[optionIdx] = e.target.value;
                });
            });
            quizItemDiv.querySelector('.correct-answer-select').addEventListener('change', (e) => {
                tempEditingQuizData[index].answer = parseInt(e.target.value);
            });
            quizItemDiv.querySelector('.delete-question-btn').addEventListener('click', () => {
                tempEditingQuizData.splice(index, 1); // Remove from temporary array
                renderTempQuizData(); // Re-render to update indices and display
            });
        }

        function addNewQuestion() {
            const newQuestion = {
                question: '',
                options: ['', '', '', ''],
                answer: 0
            };
            tempEditingQuizData.push(newQuestion);
            // Re-render all to ensure correct indices and new item appears
            renderTempQuizData();
            // Scroll to the new item
            quizEditorList.lastElementChild?.scrollIntoView({ behavior: 'smooth', block: 'end' });
        }

        function saveQuizChanges() {
            // Basic validation
            for (let i = 0; i < tempEditingQuizData.length; i++) {
                const q = tempEditingQuizData[i];
                if (!q.question.trim()) {
                    showMessage(`問題 ${i + 1}: 問題內容不能為空！`);
                    return;
                }
                if (q.options.some(opt => !opt.trim())) {
                    showMessage(`問題 ${i + 1}: 所有選項都不能為空！`);
                    return;
                }
                if (q.answer === undefined || q.answer < 0 || q.answer > 3) {
                    showMessage(`問題 ${i + 1}: 正確答案選擇無效！`);
                    return;
                }
            }

            // Update the actual gameState with the validated temporary data
            if (editingQuizBankName) {
                gameState.quizzes[editingQuizBankName] = tempEditingQuizData;
                // Reset available indices for this bank as content changed
                gameState.availableQuizIndices[editingQuizBankName] = Array.from({ length: tempEditingQuizData.length }, (_, i) => i);
            }

            closeSpecificModal(modals.editQuiz);
            renderQuizBankSelection(); // Re-render the main quiz bank list to reflect changes (e.g., question count)
            showAIToast('題庫變更已儲存！', 'success', 2500);
        }

        // --- Centralized UI Visibility Management ---
        function updateScreenVisibility() {
            const topLeftControls = document.getElementById('game-controls-top-left');
            const topRightControls = document.getElementById('game-controls-top-right');

            if (!setupScreen.classList.contains('hidden')) { // On Setup Screen
                aiDesignGameBtnContainer.classList.remove('hidden');
                topLeftControls.classList.add('hidden');
                topRightControls.classList.add('hidden');
                // Export is disabled on setup, import is enabled
                document.getElementById('export-game-btn').disabled = true;
                document.getElementById('export-game-btn').classList.add('opacity-50', 'cursor-not-allowed');
                document.getElementById('import-game-btn').disabled = false;
                document.getElementById('import-game-btn').classList.remove('opacity-50', 'cursor-not-allowed');

            } else if (!gameScreen.classList.contains('hidden')) { // On Game Screen
                aiDesignGameBtnContainer.classList.add('hidden');
                topLeftControls.classList.remove('hidden');
                topRightControls.classList.remove('hidden');
                // Export is enabled during game, import is enabled (but might pause/reset game)
                document.getElementById('export-game-btn').disabled = false;
                document.getElementById('export-game-btn').classList.remove('opacity-50', 'cursor-not-allowed');
                document.getElementById('import-game-btn').disabled = false;
                document.getElementById('import-game-btn').classList.remove('opacity-50', 'cursor-not-allowed');
            }
            // Ensure display flex for control containers so gap works
            topLeftControls.style.display = topLeftControls.classList.contains('hidden') ? 'none' : 'flex';
            topRightControls.style.display = topRightControls.classList.contains('hidden') ? 'none' : 'flex';
        }

        // Initial call to set up visibility when the page loads
        window.onload = () => {
            renderFarmGallery();
            loadGame();
            // This ensures the visibility is set correctly initially, especially for the AI button
            // After loadGame determines which screen to show, updateScreenVisibility will finalize
        };
    </script>

    <script>
    // 設定畫面：一步一步精靈（只負責顯示/切換，不改動遊戲邏輯）
    (function () {
        const steps = Array.from(document.querySelectorAll('#setup-screen .wizard-step'));
        const bar = document.getElementById('wizard-progress');
        const nav = document.getElementById('wizard-nav');
        const prev = document.getElementById('wizard-prev');
        const next = document.getElementById('wizard-next');
        if (!steps.length || !bar || !nav) return;
        let cur = 0;
        function optText(id) { const el = document.getElementById(id); return el ? el.options[el.selectedIndex].text.replace(/\s*\(預設\)/, '') : ''; }
        function summary() {
            const box = document.getElementById('wizard-summary'); if (!box) return;
            const money = document.getElementById('initial-money-select'), time = document.getElementById('game-time-select');
            const m = money && money.value === 'custom' ? '$' + (document.getElementById('initial-money-custom').value || '') : optText('initial-money-select');
            const t = time && time.value === 'custom' ? (document.getElementById('game-time-custom').value || '') + ' 分鐘' : optText('game-time-select');
            let q = '';
            try { const n = gameState.activeQuizBanks.reduce((a, b) => a + (gameState.quizzes[b] ? gameState.quizzes[b].length : 0), 0); q = n + ' 題'; } catch (e) { }
            box.innerHTML = ['👥 ' + optText('player-count'), '💰 ' + m, '⏱️ ' + t].concat(q ? ['📚 ' + q] : []).map(x => '<span>' + x + '</span>').join('');
        }
        function render() {
            steps.forEach((s, i) => s.classList.toggle('active', i === cur));
            bar.innerHTML = steps.map((s, i) => '<div class="wizard-dot ' + (i < cur ? 'done' : i === cur ? 'current' : '') + '" data-go="' + i + '"><b>' + (i < cur ? '✓' : i + 1) + '</b><span>' + s.dataset.title + '</span></div>').join('');
            nav.classList.toggle('first', cur === 0);
            nav.classList.toggle('last', cur === steps.length - 1);
            next.textContent = cur === 0 ? '開始設定 →' : '下一步 →';
            if (cur === steps.length - 1) summary();
            const sc = document.getElementById('setup-screen'); if (sc && sc.scrollTo) sc.scrollTo({ top: 0 });
            window.scrollTo({ top: 0 });
        }
        next.addEventListener('click', () => { if (cur < steps.length - 1) { cur++; render(); } });
        prev.addEventListener('click', () => { if (cur > 0) { cur--; render(); } });
        bar.addEventListener('click', e => { const d = e.target.closest('.wizard-dot.done'); if (d) { cur = +d.dataset.go; render(); } });
        render();
    })();
    </script>
<script>if (!TTS.ok) { const b = document.getElementById('tts-bar'); if (b) b.style.display = 'none'; }</script>
