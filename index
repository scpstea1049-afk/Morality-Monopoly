        }

        /* Dice Animation */
        @keyframes roll {
            0% {
                transform: rotate(0deg);
                opacity: 1;
            }

            25% {
                transform: rotate(90deg);
                opacity: 0.8;
            }

            50% {
                transform: rotate(180deg);
                opacity: 1;
            }

            75% {
                transform: rotate(270deg);
                opacity: 0.8;
            }

            100% {
                transform: rotate(360deg);
                opacity: 1;
