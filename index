        /* ============================================================
           現代化馬卡龍風格外觀 (Modern Macaron Theme) — 純外觀調整
           ============================================================ */

        h1 {
            text-shadow: 0 2px 8px rgba(180, 140, 200, 0.25);
        }

        /* --- 設定畫面卡片 ---
           改為較寬的雙欄版面並縮減留白，讓所有設定項目盡量在一個畫面高度內完成，不需捲動；
           max-height + overflow-y:auto 僅作為極端小螢幕（例如直向手機）的保險，避免內容被硬性裁切。 */
        #setup-screen {
            background: linear-gradient(165deg, #ffffff 0%, #fff6fb 55%, #f6f0ff 100%) !important;
            border-radius: 28px !important;
            border: 2px solid rgba(255, 182, 213, 0.55);
            box-shadow: 0 25px 50px -12px rgba(196, 158, 222, 0.35), 0 0 0 6px rgba(255, 255, 255, 0.6) inset;
            position: relative;
            overflow-y: auto;
            overflow-x: hidden;
            max-height: 96vh;
            padding: 1.5rem 2rem;
        }

        .setup-title {
            font-size: 1.5rem;
            font-weight: 800;
            text-align: center;
            margin-bottom: 0.15rem;
        }

        .setup-subtitle {
            text-align: center;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--macaron-ink-soft);
            margin-bottom: 0.15rem;
        }

        .setup-version-badge {
            text-align: center;
            font-size: 0.7rem;
            color: var(--macaron-ink-soft);
            opacity: 0.8;
            margin-bottom: 0.85rem;
        }


        /* ===== 設定畫面：一步一步精靈 ===== */
        .wizard-progress { display:flex; justify-content:center; gap:6px; margin:0 0 14px; flex-wrap:wrap; }
        .wizard-dot { display:flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; font-size:.78rem; font-weight:700;
            background:#f3eefb; color:#9a86b8; border:1.5px solid transparent; cursor:default; }
        .wizard-dot b { display:inline-flex; width:20px; height:20px; border-radius:50%; align-items:center; justify-content:center;
            background:#d9cdee; color:#fff; font-size:.72rem; }
        .wizard-dot.done { background:#eaf8ee; color:#3b8a57; cursor:pointer; }
        .wizard-dot.done b { background:#5cb77a; }
        .wizard-dot.current { background:#fff2f8; color:#c2487f; border-color:#ffb6d5; }
        .wizard-dot.current b { background:#ff7eb3; }
        @media (max-width:480px) { .wizard-dot span { display:none; } .wizard-dot.current span { display:inline; } }
        .wizard-step { display:none; animation: wizardIn .25s ease; }
        .wizard-step.active { display:block; }
        @keyframes wizardIn { from { opacity:0; transform:translateX(14px);} to { opacity:1; transform:none; } }
        .wizard-h { font-size:1.35rem; font-weight:800; text-align:center; margin:4px 0 2px; color:#6b4f93; }
        .wizard-hint { text-align:center; font-size:.85rem; color:#7a6a8c; margin:0 0 14px; }
        .wizard-step[data-step="2"] .player-details-grid, .wizard-step[data-step="3"] .setup-row-2 { max-width:640px; margin-left:auto; margin-right:auto; }
        .wizard-step[data-step="2"] .setup-field:first-of-type { max-width:260px; margin:0 auto 10px; }
        .wizard-step[data-step="4"] .quiz-bank-scroll { max-height:220px; }
        .wizard-step[data-step="4"] > .setup-field { max-width:640px; margin:0 auto; }
        .wizard-step[data-step="5"] .setup-row-2 { max-width:640px; margin:0 auto; }
        .wizard-actions-2 { grid-template-columns: 1fr 1fr !important; max-width:520px; margin-left:auto; margin-right:auto; }
        .wizard-summary { display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin:6px 0 14px; }
        .wizard-summary span { background:#f6f0ff; border:1.5px solid #e0d0f5; border-radius:999px; padding:6px 14px; font-weight:700; color:#6b4f93; font-size:.9rem; }
        .wizard-start { max-width:420px; margin:18px auto 0; }
        .wizard-nav { display:flex; justify-content:space-between; gap:10px; max-width:640px; margin:18px auto 0; }
        .wizard-btn { padding:10px 22px; border-radius:12px; font-weight:800; font-size:1rem; transition:all .2s; }
        .wizard-btn-prev { background:#f1ecf8; color:#7a5fa6; }
        .wizard-btn-prev:hover { background:#e6def3; }
        .wizard-btn-next { background:linear-gradient(135deg,#ff9ec7,#b794f4); color:#fff; margin-left:auto; box-shadow:0 4px 10px rgba(183,148,244,.4); }
        .wizard-btn-next:hover { filter:brightness(1.06); transform:translateY(-1px); }
        .wizard-nav.first #wizard-prev, .wizard-nav.last #wizard-next { display:none; }
        .wizard-nav.first { justify-content:center; }
        .wizard-nav.first .wizard-btn-next { margin:0 auto; padding:12px 44px; font-size:1.1rem; }
        #setup-screen { max-height: none !important; }

        .setup-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 0.75rem 1.5rem;
