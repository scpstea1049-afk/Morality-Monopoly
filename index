            100% {
                box-shadow: 0 0 6px 2px rgba(255, 214, 100, 0.6), 0 0 12px 4px rgba(255, 180, 80, 0.35);
            }

            50% {
                box-shadow: 0 0 12px 5px rgba(255, 214, 100, 0.95), 0 0 20px 8px rgba(255, 180, 80, 0.55);
            }
        }

