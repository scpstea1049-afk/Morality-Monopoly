            border-radius: 4px;
            background:
                radial-gradient(rgba(26, 26, 46, 0.08) 1px, transparent 1.4px) 0 0 / 8px 8px,
                linear-gradient(165deg, #ffffff 0%, #fbf8f2 60%, #f5efe6 100%);
