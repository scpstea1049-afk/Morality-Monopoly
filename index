                        assetDetails = `<span style="font-size: 9px; color: ${isDark(propColor) ? 'white' : '#374151'};"> 現值: $${currentValue} / 租金: $${currentRent}</span>`;
                    }

                    return `
                        <div class="inline-block text-xs font-semibold mr-1 mb-1 px-1.5 py-0.5 rounded" style="background-color:${propColor}; color: ${isDark(propColor) ? 'white' : 'black'}">
                            ${p.name}
                            <br>${assetDetails}
                        </div>`;
                }).join('');
                if (propertiesHTML === '') propertiesHTML = '<span class="text-xs text-gray-500">無</span>';

                const totalAssets = player.money + propertyValueSum;

                // Added a span for jail status within the player info div
                playerDiv.innerHTML = `
                    <div class="flex justify-between items-center">
                        <h4 class="text-lg font-bold" style="color:${playerColors[player.id]}">${farmPlayerImage(player, "farm-avatar")} ${player.name}</h4>
                        <div style="text-align:right;">
                            <div class="text-lg font-semibold">$${player.money.toLocaleString()}</div>
                            <div style="font-size:10px;color:#9ca3af;">總資產: $${totalAssets.toLocaleString()}</div>
                        </div>
                    </div>
                    <div id="player-jail-status-${player.id}" class="text-sm text-red-500 font-semibold mb-1 hidden"></div> <!-- New jail status display -->
                    <div class="mt-2 player-info-assets-wrap"><h5 class="text-sm font-bold mb-1">資產: <span style="font-weight:normal;color:#9ca3af;">（點擊查看完整歷程）</span></h5><div class="property-list">${propertiesHTML}</div></div>`;
                playerDiv.title = '點擊查看此玩家的資產與收支歷程';
                playerDiv.addEventListener('click', (e) => {
                    e.stopPropagation();
                    showPlayerHistoryModal(player.id);
                });
                playerInfoContainer.appendChild(playerDiv);
            });
            updateJailStatusDisplay(); // Call to update jail status in player info
        }

        // 顯示玩家收支歷程圖層：持有土地、租金收入來源統計、完整收支紀錄
        function showPlayerHistoryModal(playerId) {
            const player = gameState.players.find(p => p.id === playerId);
            if (!player) return;
            const transactions = Array.isArray(player.transactions) ? player.transactions : [];

            // 持有土地
            const ownedProperties = gameState.board.filter(s => s.ownerId === playerId);
            const propertyValue = ownedProperties.reduce((sum, p) => sum + Math.round(p.price * 0.9), 0);
            const totalAssets = player.money + propertyValue;

            const propertiesHTML = ownedProperties.length
                ? ownedProperties.map(p => {
                    const propColor = p.group || '#A9A9A9';
